# Obtain this from Nebius Token Factory. Never commit the real value.
NEBIUS_API_KEY=

# Set this to a currently available NVIDIA Nemotron model ID from Token Factory.
NEBIUS_MODEL=

# Optional. The default is shown here for clarity.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Never place live credentials in this file or commit a populated .env.

